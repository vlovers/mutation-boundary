{
  "name": "mutation-boundary",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Assert that failed operations leave no unexpected net PostgreSQL row changes",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test test/core.test.ts test/safety.test.ts",
    "test:postgres": "node --experimental-strip-types --test test/postgres.test.ts",
    "prepack": "npm run build",
    "check:package": "npm pack --dry-run",
    "test:consumer": "node scripts/consumer-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "pg": "^8.16.3",
    "@types/pg": "^8.15.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vlovers/mutation-boundary.git"
  },
  "homepage": "https://github.com/vlovers/mutation-boundary#readme",
  "bugs": {
    "url": "https://github.com/vlovers/mutation-boundary/issues"
  },
  "keywords": [
    "postgresql",
    "integration-testing",
    "database",
    "assertion",
    "regression",
    "mutation"
  ],
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false
}
