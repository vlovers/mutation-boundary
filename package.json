{
  "name": "mutation-boundary",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Experimental PostgreSQL net-state mutation assertions for integration tests",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "test:postgres": "node --experimental-strip-types --test test/postgres.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "pg": "^8.16.3",
    "@types/pg": "^8.15.5"
  }
}
